---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { otherLocale, type Locale } from '@/lib/i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const lang = locale === 'zh' ? 'zh-Hans' : 'en';
const self = Astro.url.href;

// Locale alternates for hreflang
const enPath = Astro.url.pathname.replace(`/${locale}`, '/en');
const zhPath = Astro.url.pathname.replace(`/${locale}`, '/zh');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={self} />
    <link rel="alternate" hreflang="en" href={enPath} />
    <link rel="alternate" hreflang="zh" href={zhPath} />
    <link rel="alternate" hreflang="x-default" href={self} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content="Astro" />
    <script type="module" defer src="/scripts/site.js"></script>
  </head>
  <body>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
