---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { locales, type Locale } from '@/lib/i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const lang = locale === 'zh' ? 'zh-Hans' : locale;
const self = Astro.url.href;

// Locale alternates for hreflang (one per supported locale)
const localePaths = locales.map((l) => ({
  href: Astro.url.pathname.replace(`/${locale}`, `/${l}`),
  l,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/images/favicon.jpg" type="image/jpeg" />
    <link rel="canonical" href={self} />
    {localePaths.map((p) => <link rel="alternate" hreflang={p.l} href={p.href} />)}
    <link rel="alternate" hreflang="x-default" href={self} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content="Astro" />
    <!-- Apply theme before paint to avoid a flash of the wrong scheme -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <script type="module" defer src="/scripts/site.js"></script>
  </head>
  <body>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
