---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin — QNCMS</title>
    <script>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) { document.documentElement.dataset.theme = 'light'; }
      })();
    </script>
    <style is:global>
      :root {
        --brand: #2563eb; --ink: #0b1020; --ink-soft: #475069;
        --bg: #fff; --bg-soft: #f5f7fb; --line: #e6e9f2;
        --card: #fff;
      }
      html[data-theme="dark"] {
        color-scheme: dark;
        --brand: #60a5fa; --ink: #e7eaf4; --ink-soft: #a7b0c5;
        --bg: #0b1020; --bg-soft: #12182b; --line: #232c47;
        --card: #141b30;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg-soft); color: var(--ink); transition: background .3s, color .3s; }
      .login-screen, .app { min-height: 100vh; }
      .login-screen { display: flex; align-items: center; justify-content: center; position: relative; }
      .login-lang { position: absolute; top: 20px; right: 24px; display: flex; gap: 8px; }
      .login-box { background: var(--card); padding: 40px; border-radius: 16px; box-shadow: 0 10px 40px rgba(11,16,32,.1); width: 100%; max-width: 360px; border: 1px solid var(--line); }
      html[data-theme="dark"] .login-box { box-shadow: 0 10px 40px rgba(0,0,0,.5); }
      .login-box h1 { font-size: 1.5rem; margin-bottom: 8px; }
      .login-box p { color: var(--ink-soft); margin-bottom: 24px; font-size: .9rem; }
      .field { margin-bottom: 16px; }
      .field label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: 6px; }
      .field input, .field textarea { width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 1rem; background: var(--bg); color: var(--ink); }
      .field textarea { min-height: 90px; resize: vertical; }
      .field input:focus, .field textarea:focus { outline: none; border-color: var(--brand); }
      .btn { padding: 12px 24px; border-radius: 10px; font-weight: 600; cursor: pointer; border: none; font-size: .95rem; transition: all .2s; }
      .btn-primary { background: var(--brand); color: #fff; }
      .btn-primary:hover { filter: brightness(1.08); }
      .error { color: #dc2626; font-size: .85rem; margin-top: 8px; }
      .app { display: flex; flex-direction: column; }
      .header { background: var(--card); border-bottom: 1px solid var(--line); padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
      .header h1 { font-size: 1.2rem; }
      .header-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
      .tabs { display: flex; gap: 4px; }
      .tab-btn { padding: 8px 18px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg-soft); color: var(--ink-soft); font-weight: 600; cursor: pointer; font-size: .9rem; }
      .tab-btn.active { background: var(--brand); color: #fff; border-color: var(--brand); }
      .main { flex: 1; padding: 24px; max-width: 1200px; margin: 0 auto; width: 100%; }
      .card { background: var(--card); border-radius: 16px; border: 1px solid var(--line); padding: 24px; margin-bottom: 24px; }
      .card h2 { font-size: 1.1rem; margin-bottom: 16px; }
      .card .sub { color: var(--ink-soft); font-size: .9rem; margin-bottom: 20px; }
      .product-list { display: grid; gap: 16px; }
      .product-item { display: flex; gap: 16px; padding: 16px; background: var(--bg-soft); border-radius: 12px; align-items: center; }
      .product-item img { width: 80px; height: 60px; object-fit: cover; border-radius: 8px; }
      .product-info { flex: 1; }
      .product-info h3 { font-size: 1rem; margin-bottom: 4px; }
      .product-info p { font-size: .85rem; color: var(--ink-soft); }
      .btn-sm { padding: 8px 16px; font-size: .85rem; border-radius: 8px; }
      .btn-danger { background: #dc2626; color: #fff; }
      .btn-success { background: #16a34a; color: #fff; }
      .btn-ghost { background: var(--bg-soft); color: var(--ink); border: 1px solid var(--line); }
      .hint { color: var(--ink-soft); font-size: .8rem; margin-top: 4px; }
      .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); align-items: center; justify-content: center; z-index: 100; }
      .modal.active { display: flex; }
      .modal-content { background: var(--card); padding: 32px; border-radius: 16px; width: 100%; max-width: 880px; max-height: 92vh; overflow-y: auto; }
      .modal-content h2 { margin-bottom: 24px; }
      .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .form-group { margin-bottom: 16px; }
      .form-group label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: 6px; }
      .form-group input, .form-group textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: .95rem; background: var(--bg); color: var(--ink); }
      .form-group textarea { min-height: 80px; resize: vertical; }
      .actions { display: flex; gap: 12px; margin-top: 24px; align-items: center; }
      .status { font-size: .85rem; margin-top: 12px; }
      .status.ok { color: #16a34a; }
      .status.err { color: #dc2626; }
      .view-toggle { display: inline-flex; gap: 4px; margin-bottom: 16px; }
      .view-btn { padding: 6px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg-soft); color: var(--ink-soft); font-weight: 600; cursor: pointer; font-size: .85rem; }
      .view-btn.active { background: var(--brand); color: #fff; border-color: var(--brand); }
      .products-admin-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
      .pg-card { background: var(--bg-soft); border-radius: 12px; overflow: hidden; border: 1px solid var(--line); }
      .pg-card img { width: 100%; height: 140px; object-fit: cover; display: block; }
      .pg-body { padding: 14px; }
      .pg-body h4 { font-size: .95rem; margin-bottom: 4px; }
      .pg-body p { font-size: .8rem; color: var(--ink-soft); margin-bottom: 10px; }
      .pg-actions { display: flex; gap: 8px; }
      .table-tools { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; align-items: center; }
      .table-tools input, .table-tools select { padding: 9px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: .9rem; background: var(--bg); color: var(--ink); }
      .table-tools input { width: 220px; max-width: 100%; }
      .batch-info { font-size: .85rem; color: var(--ink-soft); }
      .view-toggle { display: inline-flex; gap: 4px; margin-left: auto; }
      .col-panel { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; padding: 10px 14px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 10px; margin-bottom: 14px; }
      .col-lang { display: inline-flex; gap: 6px; align-items: center; font-size: .85rem; color: var(--ink-soft); }
      .col-lang select { padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); font-size: .85rem; }
      .col-boxes { display: flex; gap: 14px; flex-wrap: wrap; }
      .col-panel label { display: inline-flex; gap: 6px; align-items: center; font-size: .85rem; cursor: pointer; }
      .product-table-wrap { overflow-x: auto; }
      .product-table { width: 100%; border-collapse: collapse; font-size: .85rem; table-layout: fixed; }
      .product-table th, .product-table td { padding: 8px 10px; border: 1px solid var(--line); text-align: left; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; position: relative; }
      .product-table thead th { font-weight: 700; color: var(--ink-soft); background: var(--bg-soft); user-select: none; }
      .product-table tbody tr:nth-child(even) td { background: var(--bg-soft); }
      .product-table tbody tr:hover td { background: rgba(37,99,235,.07); }
      .product-table .timg { width: 44px; height: 28px; object-fit: cover; border-radius: 4px; display: block; }
      .product-table td.img-cell { padding: 0; }
      .product-table td.img-cell .timg { display: block; width: auto; height: 100%; min-width: 52px; max-width: 160px; object-fit: cover; border-radius: 0; }
      .product-table th.check-col, .product-table td.check-col { text-align: center; }
      .product-table th.check-col { width: 56px; }
      .check-title { display: block; font-size: .72rem; color: var(--ink-soft); margin-bottom: 4px; }
      .product-table .row-check { width: 16px; height: 16px; margin: 0 auto; }
      .product-table .t-actions { white-space: nowrap; }
      .t-actions .btn-sm { display: flex; width: 100%; justify-content: center; margin: 0; }
      .msg-cell { max-width: 320px; word-break: break-word; white-space: normal; }
      .t-actions { display: flex; flex-direction: column; gap: 4px; }
      .th-resizer { position: absolute; top: 0; right: -1px; width: 7px; height: 100%; cursor: col-resize; z-index: 3; }
      .th-resizer:hover, .th-resizer.dragging { background: var(--brand); opacity: .5; }
      .td-resizer { position: absolute; left: 0; bottom: -1px; height: 5px; width: 100%; cursor: row-resize; z-index: 2; }
      .td-resizer:hover, .td-resizer.dragging { background: var(--brand); opacity: .4; }
      .product-item .row-check { width: 16px; height: 16px; flex: none; }
      .pg-thumb { position: relative; }
      .pg-thumb .row-check { position: absolute; top: 8px; left: 8px; z-index: 2; width: 16px; height: 16px; background: #fff; border-radius: 3px; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
      @media (max-width: 640px) { .form-grid { grid-template-columns: 1fr; } }
          /* Language menu */
      .lang-menu { position: relative; display: inline-flex; }
      .lang-toggle {
        display: inline-flex; align-items: center; justify-content: center;
        width: 36px; height: 36px; border-radius: 50%;
        border: 1px solid var(--line); background: transparent; color: var(--ink-soft);
        cursor: pointer; transition: all .25s ease;
      }
      .lang-toggle:hover { border-color: var(--brand); color: var(--brand); }
      .lang-toggle svg { width: 18px; height: 18px; }
      .lang-pop {
        position: absolute; right: 0; top: calc(100% + 10px);
        min-width: 158px; background: var(--card); border: 1px solid var(--line);
        border-radius: 12px; box-shadow: 0 12px 30px -12px rgba(11,16,32,.25); padding: 6px; z-index: 400;
        display: grid; gap: 2px;
      }
      .lang-pop[hidden] { display: none; }
      .lang-opt {
        display: flex; align-items: center; gap: 9px; padding: 9px 12px;
        border-radius: 8px; font-weight: 600; font-size: .92rem; color: var(--ink);
        transition: background .2s ease;
      }
      .lang-opt:hover { background: var(--bg-soft); }
      .lang-opt.active { color: var(--brand); }
      .lang-opt .flag { font-size: 1.1rem; line-height: 1; }

      /* Template cards */
      .template-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 18px;
        margin-top: 18px;
      }
      .template-card {
        border: 2px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
        background: var(--card);
        transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
      }
      .template-card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px -12px rgba(11,16,32,.18); }
      .template-card.active { border-color: var(--brand); }
      .tpl-preview { height: 74px; }
      .tpl-body { padding: 14px 16px 16px; display: grid; gap: 10px; }
      .tpl-name { font-weight: 700; color: var(--ink); font-size: .95rem; }
      .tpl-badge {
        justify-self: start;
        padding: 4px 12px; border-radius: 999px;
        background: var(--brand); color: #fff; font-size: .78rem; font-weight: 700;
      }
      .template-card .btn { justify-self: start; }
          .lang-abbr {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 24px; height: 22px; padding: 0 5px;
        border-radius: 6px; background: var(--bg-soft);
        color: var(--brand); font-size: .7rem; font-weight: 800; letter-spacing: .04em;
      }
      .lang-opt.active .lang-abbr { background: var(--brand); color: #fff; }

      /* Product form groups & draft badge */
      .form-fieldset { border: 1px solid var(--line); border-radius: 12px; padding: 16px; margin-bottom: 16px; background: var(--bg-soft); }
      .fs-title { font-weight: 700; font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--brand); margin-bottom: 12px; }
      .draft-badge { display: inline-block; padding: 2px 9px; border-radius: 999px; background: #f59e0b; color: #fff; font-size: .68rem; font-weight: 700; margin-left: 8px; vertical-align: middle; }
      .status-toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--bg); }
      .status-btn { padding: 10px 20px; border: none; background: transparent; color: var(--ink-soft); font-weight: 600; font-size: .95rem; line-height: 1.2; cursor: pointer; transition: all .2s ease; }
      .status-btn + .status-btn { border-left: 1px solid var(--line); }
      .status-btn:hover { color: var(--brand); }
      .status-btn.active { background: var(--brand); color: #fff; }
      .price-row { display: grid; grid-template-columns: 92px 1fr; gap: 10px; }
      .price-row select { padding: 12px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: .95rem; background: var(--bg); color: var(--ink); }
      .tpl-layout-preview { height: 74px; display: grid; gap: 6px; padding: 10px 12px; background: var(--bg-soft); }
      .tpl-layout-preview .lp-head { height: 8px; border-radius: 4px; background: var(--line); }
      .tpl-layout-preview .lp-hero { height: 18px; border-radius: 4px; background: linear-gradient(90deg, var(--brand), var(--brand-2, var(--brand))); opacity: .5; }
      .tpl-layout-preview .lp-hero2 { height: 18px; width: 55%; border-radius: 4px; background: linear-gradient(90deg, var(--brand), var(--brand-2, var(--brand))); opacity: .45; }
      .tpl-layout-preview .lp-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
      .tpl-layout-preview.modern .lp-cards i { border-radius: 4px; background: var(--line); }
      .tpl-layout-preview.modern .lp-cards i:nth-child(2) { background: var(--brand); opacity: .25; }
      .tpl-layout-preview.classic .lp-cards { grid-template-columns: 1fr; }
      .tpl-layout-preview.classic .lp-cards i { height: 6px; width: 100%; border-radius: 3px; background: var(--line); }
      .tpl-layout-preview.classic .lp-cards i:nth-child(2) { width: 70%; }
      .tpl-layout-preview.classic .lp-cards i:nth-child(3) { width: 85%; }
      .tpl-group-title { font-size: .95rem; margin: 22px 0 4px; color: var(--ink-soft); font-weight: 700; }

      /* Template (color scheme) overrides — admin UI preview follows the applied template */
      html[data-variant="ocean"] { --brand: #0e7490; --brand-grad: linear-gradient(135deg,#06b6d4,#2563eb); }
      html[data-variant="forest"] { --brand: #059669; --brand-grad: linear-gradient(135deg,#10b981,#0d9488); }
      html[data-variant="sunset"] { --brand: #ea580c; --brand-grad: linear-gradient(135deg,#f97316,#db2777); }
    </style>
  </head>
  <body>
    <div id="app">
      <!-- ============ LOGIN ============ -->
      <div class="login-screen" id="loginScreen">
        <div class="login-lang">
          <div class="lang-menu">
            <button class="lang-toggle" type="button" aria-label="Language / 语言" onclick="toggleLangMenu(event)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
            </button>
            <div class="lang-pop" id="langPopLogin" hidden>
              <a class="lang-opt" data-lang-btn="en" href="javascript:void(0)" onclick="setUiLang('en'); hideLangMenu(event)"><span class="lang-abbr" aria-hidden="true">EN</span>English</a>
              <a class="lang-opt" data-lang-btn="zh" href="javascript:void(0)" onclick="setUiLang('zh'); hideLangMenu(event)"><span class="lang-abbr" aria-hidden="true">中</span>中文</a>
            </div>
          </div>
        </div>
        <div class="login-box">
          <h1 data-i18n="loginTitle">Admin Login</h1>
          <p data-i18n="loginSub">Enter your credentials to manage the site</p>
          <form id="loginForm">
            <div class="field">
              <label data-i18n="username">Username</label>
              <input type="text" id="username" required autocomplete="username" />
            </div>
            <div class="field">
              <label data-i18n="password">Password</label>
              <input type="password" id="password" required autocomplete="current-password" />
            </div>
            <div id="loginError" class="error"></div>
            <button type="submit" class="btn btn-primary" style="width:100%" data-i18n="signIn">Sign In</button>
          </form>
        </div>
      </div>

      <!-- ============ ADMIN APP ============ -->
      <div class="app" id="adminApp" style="display:none">
        <header class="header">
          <h1 data-i18n="adminTitle">Site Admin</h1>
          <div class="header-actions">
            <div class="tabs">
              <button class="tab-btn active" id="tabProductsBtn" onclick="switchTab('products')" data-i18n="tabProducts">Products</button>
              <button class="tab-btn" id="tabTemplatesBtn" onclick="switchTab('templates')" data-i18n="tabTemplates">Templates</button>
              <button class="tab-btn" id="tabMessagesBtn" onclick="switchTab('messages')" data-i18n="tabMessages">Messages</button>
              <button class="tab-btn" id="tabSettingsBtn" onclick="switchTab('settings')" data-i18n="tabSettings">Settings</button>
            </div>
            <div class="lang-menu">
              <button class="lang-toggle" type="button" aria-label="Language / 语言" onclick="toggleLangMenu(event)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
              </button>
              <div class="lang-pop" id="langPop" hidden>
                <a class="lang-opt" data-lang-btn="en" href="javascript:void(0)" onclick="setUiLang('en'); hideLangMenu(event)"><span class="lang-abbr" aria-hidden="true">EN</span>English</a>
                <a class="lang-opt" data-lang-btn="zh" href="javascript:void(0)" onclick="setUiLang('zh'); hideLangMenu(event)"><span class="lang-abbr" aria-hidden="true">中</span>中文</a>
              </div>
            </div>
            <button class="btn btn-sm btn-ghost" id="themeToggle" type="button" aria-label="Toggle dark mode">🌙</button>
            <button class="btn btn-sm btn-ghost" onclick="logout()" data-i18n="logout">Logout</button>
          </div>
        </header>
        <main class="main">
          <!-- Products -->
          <div class="card" id="panelProducts">
            <h2 data-i18n="tabProducts">Products</h2>
            <div class="table-tools" id="tableTools">
              <button class="btn btn-primary btn-sm" onclick="openModal()" data-i18n="addProduct">+ Add Product</button>
              <input type="search" id="tableSearch" data-i18n-ph="searchPlaceholder" placeholder="Search name or slug..." />
              <select id="tableCategory"></select>
              <button class="btn btn-sm btn-danger" id="batchDeleteBtn" onclick="batchDelete()" data-i18n="batchDelete">Delete Selected</button>
              <span id="batchInfo" class="batch-info"></span>
              <select id="statusFilter" onchange="onStatusFilter(this.value)" title="Status / 状态">
                <option value="">All（全部）</option>
                <option value="published">Published（已发布）</option>
                <option value="draft">Draft（草稿）</option>
              </select>
              <span class="view-toggle">
                <button class="view-btn active" id="viewListBtn" onclick="setProductView('list')" data-i18n="viewList">List</button>
                <button class="view-btn" id="viewGridBtn" onclick="setProductView('grid')" data-i18n="viewGrid">Grid</button>
                <button class="view-btn" id="viewTableBtn" onclick="setProductView('table')" data-i18n="viewTable">Table</button>
              </span>
            </div>
            <div class="col-panel" id="colPanel" style="display:none">
              <span class="col-lang">
                <span data-i18n="tableLangLabel">Display language:</span>
                <select id="tableLang">
                  <option value="en">EN</option>
                  <option value="zh">中文</option>
                </select>
              </span>
              <span class="col-boxes" id="colPanelBoxes"></span>
            </div>
            <div class="product-list" id="productList">Loading...</div>
          </div>

          <!-- Settings -->
          <div class="card" id="panelSettings" style="display:none">
            <h2 data-i18n="tabSettings">Site Settings</h2>
            <p class="sub" data-i18n="settingsSub">Site title, logo, favicon, hero banner, about and contact info (applied to the public site without redeploy)</p>
            <form id="settingsForm">
              <h3 style="font-size:1rem;margin:8px 0 16px;color:var(--brand);" data-i18n="secBranding">Branding</h3>
              <div class="form-grid">
                <div class="form-group">
                  <label data-i18n="siteTitleEn">Site Title (EN)</label>
                  <input type="text" id="site_title_en" placeholder="NovaGrid" />
                </div>
                <div class="form-group">
                  <label data-i18n="siteTitleZh">Site Title (ZH)</label>
                  <input type="text" id="site_title_zh" placeholder="新星网格" />
                </div>
              </div>
              <div class="form-grid">
                <div class="form-group">
                  <label data-i18n="logoUrl">Logo URL (optional, replaces text logo)</label>
                  <input type="url" id="logo_url" placeholder="https://example.com/logo.png" />
                  <div class="hint" data-i18n="logoUrlHint">Leave empty to keep the default text logo</div>
                </div>
                <div class="form-group">
                  <label data-i18n="faviconUrl">Favicon URL (optional)</label>
                  <input type="url" id="favicon_url" placeholder="https://example.com/favicon.ico" />
                </div>
              </div>
              <h3 style="font-size:1rem;margin:24px 0 16px;color:var(--brand);" data-i18n="secHero">Hero (Homepage Banner)</h3>
              <div class="form-grid">
                <div class="form-group">
                  <label data-i18n="heroTitle1En">Hero Title Line 1 (EN)</label>
