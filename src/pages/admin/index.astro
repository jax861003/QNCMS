      async function loadSettings() {
        if (!token) return;
        try {
          var resp = await fetch('/api/settings', {
            headers: { 'Authorization': 'Bearer ' + token }
          });
          if (resp.status === 401) { sessionExpired(); return; }
          var s = await resp.json();
          if (!s || typeof s !== 'object') return;
          var map = {
            site_title_en: 'site_title_en', site_title_zh: 'site_title_zh',
            logo_url: 'logo_url', favicon_url: 'favicon_url',
            about_title_en: 'about_title_en', about_title_zh: 'about_title_zh',
            about_body_en: 'about_body_en', about_body_zh: 'about_body_zh',
            contact_email: 'contact_email', contact_phone: 'contact_phone',
            contact_address: 'contact_address',
            hero_title1_en: 'hero_title1_en', hero_title1_zh: 'hero_title1_zh',
            hero_title2_en: 'hero_title2_en', hero_title2_zh: 'hero_title2_zh',
            hero_subtitle_en: 'hero_subtitle_en', hero_subtitle_zh: 'hero_subtitle_zh',
            hero_image_url: 'hero_image_url',
            products_title_en: 'products_title_en', products_title_zh: 'products_title_zh',
            products_subtitle_en: 'products_subtitle_en', products_subtitle_zh: 'products_subtitle_zh',
            contact_qq: 'contact_qq', contact_wechat: 'contact_wechat',
            footer_github: 'footer_github', footer_twitter: 'footer_twitter',
            footer_copyright: 'footer_copyright',
            theme_name: 'theme_name'
          };
          Object.keys(map).forEach(function (key) {
            var el = document.getElementById(map[key]);
            if (!el) return;
            var v = s[key];
            if (v === undefined || v === null || v === '') v = DEFAULT_COPY[key] || '';
            el.value = v;
          });
        } catch (err) { /* keep empty */ }
        // template (color scheme) is managed in the Templates tab
      }

      document.getElementById('settingsForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        var data = {
          site_title_en: document.getElementById('site_title_en').value,
          site_title_zh: document.getElementById('site_title_zh').value,
          logo_url: document.getElementById('logo_url').value,
          favicon_url: document.getElementById('favicon_url').value,
          about_title_en: document.getElementById('about_title_en').value,
          about_title_zh: document.getElementById('about_title_zh').value,
          about_body_en: document.getElementById('about_body_en').value,
          about_body_zh: document.getElementById('about_body_zh').value,
          contact_email: document.getElementById('contact_email').value,
          contact_phone: document.getElementById('contact_phone').value,
          contact_address: document.getElementById('contact_address').value,
          hero_title1_en: document.getElementById('hero_title1_en').value,
          hero_title1_zh: document.getElementById('hero_title1_zh').value,
          hero_title2_en: document.getElementById('hero_title2_en').value,
          hero_title2_zh: document.getElementById('hero_title2_zh').value,
          hero_subtitle_en: document.getElementById('hero_subtitle_en').value,
          hero_subtitle_zh: document.getElementById('hero_subtitle_zh').value,
          hero_image_url: document.getElementById('hero_image_url').value,
          products_title_en: document.getElementById('products_title_en').value,
          products_title_zh: document.getElementById('products_title_zh').value,
          products_subtitle_en: document.getElementById('products_subtitle_en').value,
          products_subtitle_zh: document.getElementById('products_subtitle_zh').value,
          contact_qq: document.getElementById('contact_qq').value,
          contact_wechat: document.getElementById('contact_wechat').value,
          footer_github: document.getElementById('footer_github').value,
          footer_twitter: document.getElementById('footer_twitter').value,
          footer_copyright: document.getElementById('footer_copyright').value
        };
        var statusEl = document.getElementById('settingsStatus');
        statusEl.className = 'status';
        statusEl.textContent = '';
        try {
          var resp = await fetch('/api/settings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': 'Bearer ' + token
            },
            body: JSON.stringify(data)
          });
          if (resp.status === 401) { sessionExpired(); return; }
          var result = await resp.json();
          if (result.ok) {
            statusEl.className = 'status ok';
            statusEl.textContent = ui('saved');
          } else {
            statusEl.className = 'status err';
            statusEl.textContent = ui('saveFailed') + (result.message || '');
          }
        } catch (err) {
          statusEl.className = 'status err';
          statusEl.textContent = 'Network error';
        }
      });


      // ====== Contact messages ======
      async function loadMessages() {
        var list = document.getElementById('messagesList');
        if (!list) return;
        list.innerHTML = ui('loading');
        try {
          var resp = await fetch('/api/admin/messages', { headers: { 'Authorization': 'Bearer ' + token } });
          if (resp.status === 401) { sessionExpired(); return; }
          var msgs = await resp.json();
          if (!Array.isArray(msgs)) throw new Error('bad response');
          renderMessages(msgs);
        } catch (err) {
          list.innerHTML = '<div style="color:#dc2626;padding:16px;">' + ui('msgLoadFailed') + '</div>';
        }
      }
      function renderMessages(msgs) {
        var list = document.getElementById('messagesList');
        if (!list) return;
        if (msgs.length === 0) {
          list.className = 'product-list';
          list.innerHTML = '<div style="color:#888;padding:16px;">' + ui('msgEmpty') + '</div>';
          return;
        }
        list.className = 'product-table-wrap';
        var labels = { time: ui('msgTime'), name: ui('msgName'), email: ui('msgEmail'), phone: ui('msgPhone'), message: ui('msgContent'), actions: ui('msgActions') };
        var head = ['time', 'name', 'email', 'phone', 'message', 'actions'].map(function (k) {
          return '<th>' + (labels[k] || k) + '</th>';
        }).join('');
        var rows = msgs.map(function (m) {
          var t = (m.created_at || '').replace('T', ' ').replace(/\..+Z?$/, '').replace('Z', '');
          return '<tr><td style="white-space:nowrap">' + esc(t) + '</td>' +
            '<td>' + esc(m.name || '') + '</td>' +
            '<td>' + esc(m.email || '') + '</td>' +
            '<td>' + esc(m.phone || '') + '</td>' +
            '<td class="msg-cell">' + esc(m.message || '') + '</td>' +
            '<td style="white-space:nowrap"><button class="btn btn-sm btn-danger" onclick="deleteMessage(\'' + m.id + '\')">' + ui('delete') + '</button></td></tr>';
        }).join('');
        list.innerHTML = '<table class="product-table"><thead><tr>' + head + '</tr></thead><tbody>' + rows + '</tbody></table>';
      }
      async function deleteMessage(id) {
        if (!confirm(ui('msgDeleteConfirm'))) return;
        try {
          var resp = await fetch('/api/admin/messages?id=' + encodeURIComponent(id), {
            method: 'DELETE',
            headers: { 'Authorization': 'Bearer ' + token }
          });
          if (resp.status === 401) { sessionExpired(); return; }
          var data = await resp.json();
          if (!data.ok) { alert(ui('deleteFailed') + (data.message || '')); return; }
          loadMessages();
        } catch (err) { alert('Network error'); }
      }

      // ====== Templates (layout + color scheme) ======
      var LAYOUTS = [
        { id: 'classic', nameKey: 'layoutClassic', desc: 'classic' },
        { id: 'modern', nameKey: 'layoutModern', desc: 'modern' }
      ];
      var THEMES = [
        { id: 'default', grad: 'linear-gradient(135deg,#2563eb,#7c3aed)', nameKey: 'tplDefault' },
        { id: 'ocean', grad: 'linear-gradient(135deg,#06b6d4,#2563eb)', nameKey: 'tplOcean' },
        { id: 'forest', grad: 'linear-gradient(135deg,#10b981,#0d9488)', nameKey: 'tplForest' },
        { id: 'sunset', grad: 'linear-gradient(135deg,#f97316,#db2777)', nameKey: 'tplSunset' }
      ];
      var currentLayout = 'classic';
      var currentTemplate = 'default';

      async function loadTemplates() {
        try {
          var resp = await fetch('/api/settings', { headers: { Accept: 'application/json' } });
          var s = await resp.json();
          if (s && s.layout_name) currentLayout = s.layout_name;
          if (s && s.theme_name) currentTemplate = s.theme_name;
        } catch (e) { /* keep defaults */ }
        document.documentElement.setAttribute('data-layout', currentLayout);
        document.documentElement.setAttribute('data-variant', currentTemplate);
        renderLayouts();
        renderThemes();
      }
      function renderLayouts() {
        var grid = document.getElementById('layoutGrid');
        if (!grid) return;
        grid.innerHTML = LAYOUTS.map(function (t) {
          var active = t.id === currentLayout;
          return '<div class="template-card' + (active ? ' active' : '') + '" data-tpl="' + t.id + '">' +
            '<div class="tpl-preview" style="padding:0">' +
            (t.id === 'modern'
              ? '<div class="tpl-layout-preview modern"><span class="lp-head"></span><span class="lp-hero"></span><span class="lp-cards"><i></i><i></i><i></i></span></div>'
              : '<div class="tpl-layout-preview classic"><span class="lp-head"></span><span class="lp-hero2"></span><span class="lp-cards"><i></i><i></i></span></div>') +
            '</div>' +
            '<div class="tpl-body">' +
            '<div class="tpl-name">' + ui(t.nameKey) + '</div>' +
            (active
              ? '<span class="tpl-badge">' + ui('tplApplied') + '</span>'
              : '<button class="btn btn-sm btn-primary" onclick="applyLayout(\'' + t.id + '\')">' + ui('tplApply') + '</button>') +
            '</div></div>';
        }).join('');
      }
      function renderThemes() {
        var grid = document.getElementById('themeGrid');
        if (!grid) return;
        grid.innerHTML = THEMES.map(function (t) {
          var active = t.id === currentTemplate;
          return '<div class="template-card' + (active ? ' active' : '') + '" data-tpl="' + t.id + '">' +
            '<div class="tpl-preview" style="background:' + t.grad + '"></div>' +
            '<div class="tpl-body">' +
            '<div class="tpl-name">' + ui(t.nameKey) + '</div>' +
            (active
              ? '<span class="tpl-badge">' + ui('tplApplied') + '</span>'
              : '<button class="btn btn-sm btn-primary" onclick="applyTheme(\'' + t.id + '\')">' + ui('tplApply') + '</button>') +
            '</div></div>';
        }).join('');
      }
      async function applyLayout(id) {
        try {
          var resp = await fetch('/api/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            body: JSON.stringify({ layout_name: id })
          });
          var data = await resp.json();
          if (resp.status === 401) { sessionExpired(); return; }
          if (!data.ok) { alert(ui('saveFailed') + (data.message || '')); return; }
          currentLayout = id;
          document.documentElement.setAttribute('data-layout', id);
          renderLayouts();
        } catch (err) { alert('Network error'); }
      }
      async function applyTheme(id) {
        try {
          var resp = await fetch('/api/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            body: JSON.stringify({ theme_name: id })
          });
          var data = await resp.json();
          if (resp.status === 401) { sessionExpired(); return; }
          if (!data.ok) { alert(ui('saveFailed') + (data.message || '')); return; }
          currentTemplate = id;
          document.documentElement.setAttribute('data-variant', id);
          renderThemes();
        } catch (err) { alert('Network error'); }
      }

      // ====== Boot ======
      applyUi();
      // apply the saved color-scheme template to the admin UI immediately
      (function () {
        try {
          fetch('/api/settings', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : {}; })
            .then(function (s) {
              var v = (s && s.theme_name) || 'default';
              currentTemplate = v;
              document.documentElement.setAttribute('data-variant', v);
              var l = (s && s.layout_name) || 'classic';
              currentLayout = l;
              document.documentElement.setAttribute('data-layout', l);
            })
            .catch(function () { /* keep default */ });
        } catch (e) { /* ignore */ }
      })();
      if (token) {
        showAdmin();
      } else {
        loginScreen.style.display = 'flex';
      }

      // Expose handlers used by inline onclick attributes
      window.setUiLang = setUiLang;
      window.switchTab = switchTab;
      window.logout = logout;
      window.openModal = openModal;
      window.closeModal = closeModal;
      window.editProduct = editProduct;
      window.deleteProduct = deleteProduct;
      window.setProductView = setProductView;
      window.toggleColPanel = toggleColPanel;
      window.setCol = setCol;
      window.toggleAllRows = toggleAllRows;
      window.updateBatchInfo = updateBatchInfo;
      window.batchDelete = batchDelete;
      window.onTableFilter = onTableFilter;
      window.deleteMessage = deleteMessage;
      window.setActive = setActive;
      window.applyLayout = applyLayout;
      window.applyTheme = applyTheme;
      window.loadTemplates = loadTemplates;
      window.toggleLangMenu = toggleLangMenu;
      window.hideLangMenu = hideLangMenu;
      // language menus open on hover too (same as the public site)
      document.querySelectorAll('.lang-menu').forEach(function (menu) {
        var tg = menu.querySelector('.lang-toggle');
        var pop = menu.querySelector('.lang-pop');
        if (!tg || !pop) return;
        tg.addEventListener('mouseenter', function () { pop.hidden = false; });
        pop.addEventListener('mouseleave', function () { pop.hidden = true; });
      });
      document.addEventListener('click', function (e) {
        document.querySelectorAll('.lang-pop').forEach(function (pop) {
          if (!pop.hidden && !pop.contains(e.target) && !(e.target && e.target.closest && e.target.closest('.lang-menu'))) pop.hidden = true;
        });
      });
    </script>
  </body>
</html>
