      var curLang = 'zh';
      try {
        var savedLang = localStorage.getItem('admin_lang');
        if (savedLang === 'en' || savedLang === 'zh') curLang = savedLang;
      } catch (e) { /* ignore */ }

      function ui(key) { return (UI[curLang] && UI[curLang][key]) || UI.en[key] || key; }

      function applyUi() {
        document.querySelectorAll('[data-i18n]').forEach(function (el) {
          var key = el.getAttribute('data-i18n');
          if (key && UI.en[key]) el.textContent = ui(key);
        });
        document.querySelectorAll('[data-i18n-ph]').forEach(function (el) {
          var key = el.getAttribute('data-i18n-ph');
          if (key && UI.en[key]) el.placeholder = ui(key);
        if (window._currentProducts) updateCategoryFilter(window._currentProducts);
        });
        document.querySelectorAll('[data-lang-btn]').forEach(function (b) {
          b.classList.toggle('active', b.getAttribute('data-lang-btn') === curLang);
        });
        document.documentElement.lang = curLang === 'zh' ? 'zh-Hans' : 'en';
      }
      function setUiLang(l) {
        curLang = l;
        try { localStorage.setItem('admin_lang', l); } catch (e) { /* ignore */ }
        applyUi();
        refreshDynamicTexts();
      }
      function toggleLangMenu(e) {
        if (e) e.stopPropagation();
        var menu = e && e.target.closest ? e.target.closest('.lang-menu') : null;
        var pop = menu ? menu.querySelector('.lang-pop') : null;
        if (pop) pop.hidden = !pop.hidden;
      }
      function hideLangMenu(e) {
        if (e) e.stopPropagation();
        var menu = e && e.target.closest ? e.target.closest('.lang-menu') : null;
        var pop = menu ? menu.querySelector('.lang-pop') : null;
        if (pop) pop.hidden = true;
      }
      function refreshDynamicTexts() {
        var mt = document.getElementById('modalTitle');
        if (mt) mt.textContent = ui(modalProduct ? 'editProductTitle' : 'addProductTitle');
      }

      // ====== State ======
      var token = null;
      try { token = localStorage.getItem('admin_token'); } catch (e) { /* ignore */ }
      var modalProduct = null;
      var app = document.getElementById('app');
      var loginScreen = document.getElementById('loginScreen');
      var adminApp = document.getElementById('adminApp');

      // Theme toggle
      var themeToggle = document.getElementById('themeToggle');
      function currentTheme() {
        try {
          var s = localStorage.getItem('theme');
          if (s === 'light' || s === 'dark') return s;
        } catch (e) { /* ignore */ }
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      function syncThemeIcon() {
        if (themeToggle) themeToggle.textContent = currentTheme() === 'dark' ? '☀️' : '🌙';
      }
      if (themeToggle) {
        syncThemeIcon();
        themeToggle.addEventListener('click', function () {
          var next = currentTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) { /* ignore */ }
          syncThemeIcon();
        });
      }

      // ====== Auth ======
      document.getElementById('loginForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        var username = document.getElementById('username').value;
        var password = document.getElementById('password').value;
        var errorEl = document.getElementById('loginError');
        try {
          var resp = await fetch('/api/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: username, password: password })
          });
          var data = await resp.json();
          if (data.ok) {
            token = data.token;
            try { localStorage.setItem('admin_token', token); } catch (err) { /* ignore */ }
            showAdmin();
          } else {
            errorEl.textContent = data.message || ui('loginFailed');
          }
        } catch (err) {
          errorEl.textContent = 'Network error';
        }
      });

      function showAdmin() {
        loginScreen.style.display = 'none';
        adminApp.style.display = 'flex';
        applyUi();
        switchTab('products');
      }

      function logout() {
        token = null;
        modalProduct = null;
        try { localStorage.removeItem('admin_token'); } catch (e) { /* ignore */ }
        loginScreen.style.display = 'flex';
        adminApp.style.display = 'none';
        applyUi();
      }

      function sessionExpired() {
        logout();
        var el = document.getElementById('loginError');
        if (el) el.textContent = ui('sessionExpired');
      }

      // ====== Tabs ======
      function switchTab(name) {
        var p = document.getElementById('panelProducts');
        var s = document.getElementById('panelSettings');
        var m = document.getElementById('panelMessages');
        var t = document.getElementById('panelTemplates');
        var pb = document.getElementById('tabProductsBtn');
        var sb = document.getElementById('tabSettingsBtn');
        var mb = document.getElementById('tabMessagesBtn');
        var tb = document.getElementById('tabTemplatesBtn');
        function hideAll() {
          [p, s, m, t].forEach(function (el) { if (el) el.style.display = 'none'; });
          [pb, sb, mb, tb].forEach(function (el) { if (el) el.classList.remove('active'); });
        }
        if (name === 'settings') {
          hideAll(); s.style.display = 'block'; sb.classList.add('active');
          loadSettings();
        } else if (name === 'messages') {
          hideAll(); m.style.display = 'block'; mb.classList.add('active');
          loadMessages();
        } else if (name === 'templates') {
          hideAll(); t.style.display = 'block'; tb.classList.add('active');
          loadTemplates();
        } else {
          hideAll(); p.style.display = 'block'; pb.classList.add('active');
          loadProducts();
        }
      }

      // ====== Products ======
      async function loadProducts() {
        if (!token) return;
        var list = document.getElementById('productList');
        list.innerHTML = ui('loading');
        try {
          var resp = await fetch('/api/admin/products', {
            headers: { 'Authorization': 'Bearer ' + token }
          });
          if (resp.status === 401) { sessionExpired(); return; }
          var products = await resp.json();
          if (!Array.isArray(products)) throw new Error('bad response');
          if (products.length === 0) {
            list.className = 'product-list';
            list.innerHTML = '<div style="color:#888;padding:16px;">' + ui('noProducts') + '</div>';
            return;
          }
          renderProducts(products);
        } catch (err) {
          list.innerHTML = '<div style="color:#dc2626;padding:16px;">' + ui('failedLoad') + '</div>';
        }
      }

      // ====== Product view toggle (list / grid) ======
      var productView = 'list';
      try { var pv = localStorage.getItem('admin_product_view'); if (pv === 'list' || pv === 'grid' || pv === 'table') productView = pv; } catch (e) { /* ignore */ }
      document.addEventListener('DOMContentLoaded', function () {
        var s = document.getElementById('tableSearch');
        if (s) s.addEventListener('input', onTableFilter);
        var cat = document.getElementById('tableCategory');
        if (cat) cat.addEventListener('change', function () { tableFilter.category = cat.value; if (window._currentProducts) renderProducts(window._currentProducts); });
        var tlSel = document.getElementById('tableLang');
        if (tlSel) {
          tlSel.value = tableLang;
          tlSel.addEventListener('change', function () {
            tableLang = tlSel.value;
            try { localStorage.setItem('admin_table_lang', tableLang); } catch (e) { /* ignore */ }
            if (window._currentProducts) renderProducts(window._currentProducts);
          });
        }
        initTableResize();
        initRowResize();
      });

      function setProductView(v) {
        productView = v;
        try { localStorage.setItem('admin_product_view', v); } catch (e) { /* ignore */ }
        var lb = document.getElementById('viewListBtn');
        var gb = document.getElementById('viewGridBtn');
        var tb = document.getElementById('viewTableBtn');
        if (lb) lb.classList.toggle('active', v === 'list');
        if (gb) gb.classList.toggle('active', v === 'grid');
        if (tb) tb.classList.toggle('active', v === 'table');
        if (window._currentProducts) renderProducts(window._currentProducts);
      }

      // ====== Table column config ======
      var colConfig = { slug: true, name: true, category: true, tag: true, price: true, position: true, image: false };
      try {
        var cc = JSON.parse(localStorage.getItem('admin_col_config') || 'null');
        if (cc && typeof cc === 'object') colConfig = Object.assign({}, colConfig, cc);
      } catch (e) { /* ignore */ }
      function saveColConfig() {
        try { localStorage.setItem('admin_col_config', JSON.stringify(colConfig)); } catch (e) { /* ignore */ }
      }
      function colKeys() { return Object.keys(colConfig); }
      var tableLang = 'en';
      try { var tl = localStorage.getItem('admin_table_lang'); if (tl === 'en' || tl === 'zh') tableLang = tl; } catch (e) { /* ignore */ }
      function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
      function renderColPanel() {
        var box = document.getElementById('colPanelBoxes');
        if (!box) return;
        var labels = {
          slug: ui('colSlug'), name: ui('colName'), category: ui('colCategory'), tag: ui('colTag'),
          price: ui('colPrice'), position: ui('colPosition'), image: ui('colImage')
        };
        box.innerHTML = colKeys().map(function (k) {
          return '<label><input type="checkbox" ' + (colConfig[k] ? 'checked' : '') + ' onchange="setCol(\'' + k + '\', this.checked)"> ' + (labels[k] || k) + '</label>';
        }).join('');
      }
      function setCol(k, v) {
        colConfig[k] = v;
        saveColConfig();
        renderColPanel();
        if (window._currentProducts) renderProducts(window._currentProducts);
      }
      function toggleColPanel() {
        var panel = document.getElementById('colPanel');
        var visible = panel.style.display === 'block';
        panel.style.display = visible ? 'none' : 'block';
        renderColPanel();
      }

      // ====== Table filters ======
      var tableFilter = { text: '', category: '', status: '' };
      function onStatusFilter(v) { tableFilter.status = v; if (window._currentProducts) renderProducts(window._currentProducts); }
      function matchFilters(p) {
        var t = tableFilter.text.toLowerCase();
        if (t) {
          var hay = ((p.name_en || '') + ' ' + (p.name_zh || '') + ' ' + (p.slug || '')).toLowerCase();
          if (hay.indexOf(t) < 0) return false;
        }
        if (tableFilter.category) {
          if (p.category_en !== tableFilter.category && p.category_zh !== tableFilter.category) return false;
        }
        if (tableFilter.status === 'draft' && p.active !== 0) return false;
        if (tableFilter.status === 'published' && p.active === 0) return false;
        return true;
      }
      function updateCategoryFilter(products) {
        var sel = document.getElementById('tableCategory');
        if (!sel) return;
        var cats = {};
        var lang = curLang === 'zh' ? 'zh' : 'en';
        products.forEach(function (p) {
          var cat = lang === 'zh' ? (p.category_zh || p.category_en) : (p.category_en || p.category_zh);
          if (cat) cats[cat] = true;
        });
        var current = tableFilter.category;
        sel.innerHTML = '<option value="">' + ui('allCategories') + '</option>' +
          Object.keys(cats).map(function (k) { return '<option value="' + k + '">' + k + '</option>'; }).join('');
        sel.value = current;
      }
      function onTableFilter() {
        var textEl = document.getElementById('tableSearch');
        tableFilter.text = textEl ? textEl.value : '';
        if (window._currentProducts) renderProducts(window._currentProducts);
      }

      // ====== Batch delete ======
      function selectedSlugs() {
        return Array.prototype.map.call(document.querySelectorAll('.row-check:checked'), function (cb) { return cb.value; })
          .filter(Boolean);
      }
      function updateBatchInfo() {
        var info = document.getElementById('batchInfo');
        if (info) {
          var n = selectedSlugs().length;
          info.textContent = n ? ui('selectedLabel').replace('{n}', n) : '';
        }
      }
      function draftBadge(p) { return p.active === 0 ? '<span class="draft-badge">' + ui('statusDraft') + '</span>' : ''; }
      var activeVal = 1;
      function splitPrice(v) {
        var syms = ['$', '€', '¥', '£', '₽', '₩'];
        for (var i = 0; i < syms.length; i++) {
          if ((v || '').indexOf(syms[i]) === 0) return { cur: syms[i], rest: v.slice(syms[i].length).trim() };
        }
        return { cur: '$', rest: v || '' };
      }
      function setActive(v) {
        activeVal = v;
        document.querySelectorAll('#activeToggle .status-btn').forEach(function (b) {
          b.classList.toggle('active', parseInt(b.getAttribute('data-active'), 10) === v);
        });
      }
      function toggleAllRows(cb) {
        document.querySelectorAll('.row-check').forEach(function (r) { r.checked = cb.checked; });
        updateBatchInfo();
      }
      async function batchDelete() {
        var slugs = selectedSlugs();
        if (!slugs.length) return;
        if (!confirm(ui('batchDeleteConfirm') + ' (' + slugs.length + ')?')) return;
        try {
          var resp = await fetch('/api/products/batch-delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            body: JSON.stringify({ slugs: slugs })
          });
          if (resp.status === 401) { sessionExpired(); return; }
          var data = await resp.json();
          if (!data.ok) { alert(ui('deleteFailed') + (data.message || '')); return; }
          loadProducts();
        } catch (err) { alert('Network error'); }
      }

      function renderProducts(products) {
        window._currentProducts = products;
        updateCategoryFilter(products);
        var list = document.getElementById('productList');
        if (!list) return;
        var placeholder = '/images/products/placeholder.svg';
        var colPanel = document.getElementById('colPanel');
        var filtered = products.filter(matchFilters);
        var labels = { slug: ui('colSlug'), name: ui('colName'), category: ui('colCategory'), tag: ui('colTag'), price: ui('colPrice'), position: ui('colPosition'), image: ui('colImage') };
        if (productView === 'table') {
          if (colPanel) { colPanel.style.display = 'flex'; renderColPanel(); }
          var keys = colKeys().filter(function (k) { return colConfig[k]; });
          var head = '<th class="check-col"><span class="check-title">' + ui('select') + '</span><input type="checkbox" class="row-check" id="checkAll" onchange="toggleAllRows(this)"></th>';
          head += keys.map(function (k) { return '<th data-col="' + k + '">' + (labels[k] || k) + '<span class="th-resizer"></span></th>'; }).join('');
          head += '<th data-col="actions" style="width:74px">' + ui('edit') + '</th>';
          if (filtered.length === 0) {
            list.className = 'product-table-wrap';
            list.innerHTML = '<div style="padding:24px;color:#888;">' + ui('noMatch') + '</div>';
            updateBatchInfo();
            return;
          }
          var rows = filtered.map(function (p) {
            var cells = keys.map(function (k) {
              if (k === 'slug') return esc(p.slug);
              if (k === 'name') return esc(tableLang === 'zh' ? (p.name_zh || p.name_en || '') : (p.name_en || p.name_zh || '')) + draftBadge(p);
              if (k === 'category') return esc(tableLang === 'zh' ? (p.category_zh || p.category_en || '') : (p.category_en || p.category_zh || ''));
              if (k === 'tag') return esc(tableLang === 'zh' ? (p.tag_zh || p.tag_en || '') : (p.tag_en || p.tag_zh || ''));
              if (k === 'price') return esc(p.price || '');
              if (k === 'position') return p.position;
              if (k === 'image') {
                return p.image_url
                  ? '<img class="timg" src="' + p.image_url + '" onerror="this.src=\'' + placeholder + '\'">'
                  : '<img class="timg" src="' + placeholder + '">';
              }
              return '';
            }).map(function (x, idx) {
              var cls = keys[idx] === 'image' ? ' class="img-cell"' : '';
              return '<td' + cls + '>' + x + '<span class="td-resizer"></span></td>';
            }).join('');
            var editBtn = '<button class="btn btn-sm" onclick="editProduct(' + JSON.stringify(p).replace(/"/g, '&quot;') + ')">' + ui('edit') + '</button>';
            var delBtn = '<button class="btn btn-sm btn-danger" onclick="deleteProduct(\'' + p.slug + '\')">' + ui('delete') + '</button>';
            return '<tr><td class="check-col"><input type="checkbox" class="row-check" value="' + p.slug + '" onchange="updateBatchInfo()"><span class="td-resizer"></span></td>' +
              cells + '<td class="t-actions">' + editBtn + delBtn + '</td></tr>';
          }).join('');
          list.className = 'product-table-wrap';
          list.innerHTML = '<table class="product-table"><thead><tr>' + head + '</tr></thead><tbody>' + rows + '</tbody></table>';
          var ca = document.getElementById('checkAll');
          if (ca) ca.checked = selectedSlugs().length === filtered.length && filtered.length > 0;
          updateBatchInfo();
          return;
        }
        if (colPanel) colPanel.style.display = 'none';
        if (filtered.length === 0) {
          list.className = 'product-list';
          list.innerHTML = '<div style="padding:24px;color:#888;">' + ui('noMatch') + '</div>';
          updateBatchInfo();
          return;
        }
        var cards = filtered.map(function (p) {
          var img = p.image_url
            ? '<img src="' + p.image_url + '" alt="' + (p.name_en || '') + '" onerror="this.src=\'' + placeholder + '\'">'
            : '<img src="' + placeholder + '" alt="' + (p.name_en || '') + '">';
          var check = '<input type="checkbox" class="row-check" value="' + p.slug + '" onchange="updateBatchInfo()">';
          var editBtn = '<button class="btn btn-sm" onclick="editProduct(' + JSON.stringify(p).replace(/"/g, '&quot;') + ')">' + ui('edit') + '</button>';
          var delBtn = '<button class="btn btn-sm btn-danger" onclick="deleteProduct(\'' + p.slug + '\')">' + ui('delete') + '</button>';
          var priceTag = p.price ? '<div style="color:var(--brand);font-weight:700;">' + p.price + '</div>' : '';
          var catVal = tableLang === 'zh' ? (p.category_zh || p.category_en || '') : (p.category_en || p.category_zh || '');
          var catTag = catVal ? '<div style="font-size:.8rem;color:var(--ink-soft);">' + catVal + '</div>' : '';
          return { img: img, check: check, editBtn: editBtn, delBtn: delBtn, name: (p.name_en || '') + ' / ' + (p.name_zh || ''), short: p.short_en || '', priceTag: priceTag, catTag: catTag };
        });
        if (productView === 'grid') {
          list.className = 'products-admin-grid';
          list.innerHTML = cards.map(function (p) {
            return '<div class="pg-card">' +
              '<div class="pg-thumb">' + p.img + p.check + '</div>' +
              '<div class="pg-body"><h4>' + p.name + draftBadge(p) + '</h4>' + p.catTag + p.priceTag +
              '<p>' + p.short + '</p>' +
              '<div class="pg-actions">' + p.editBtn + p.delBtn + '</div></div></div>';
          }).join('');
        } else {
          list.className = 'product-list';
          list.innerHTML = cards.map(function (p) {
            return '<div class="product-item">' + p.check + p.img +
              '<div class="product-info"><h3>' + p.name + draftBadge(p) + '</h3>' + p.catTag + p.priceTag +
              '<p>' + p.short + '</p></div>' + p.editBtn + p.delBtn + '</div>';
          }).join('');
        }
        updateBatchInfo();
      }

      // ====== Column / row drag-resize (event delegation, survives re-render) ======
      function initTableResize() {
        document.addEventListener('mousedown', function (e) {
          var r = e.target && e.target.closest ? e.target.closest('.th-resizer') : null;
          if (!r) return;
          e.preventDefault();
          var th = r.parentNode;
          var table = th.closest('table');
          if (!table) return;
          var index = Array.prototype.indexOf.call(th.parentNode.children, th);
          var startX = e.clientX;
          var startW = th.getBoundingClientRect().width;
          r.classList.add('dragging');
          function move(ev) {
            var w = Math.max(48, startW + ev.clientX - startX);
            table.style.tableLayout = 'fixed';
            var col = table.querySelectorAll('colgroup col')[index];
            if (col) { col.style.width = w + 'px'; }
            else {
              var cg = table.querySelector('colgroup');
              if (!cg) {
                cg = document.createElement('colgroup');
                var n = (table.rows[0] ? table.rows[0].cells.length : 0);
                for (var i = 0; i < n; i++) cg.appendChild(document.createElement('col'));
                table.insertBefore(cg, table.firstChild);
              }
              table.querySelectorAll('colgroup col')[index].style.width = w + 'px';
            }
          }
          function up() {
            r.classList.remove('dragging');
            document.removeEventListener('mousemove', move);
            document.removeEventListener('mouseup', up);
          }
          document.addEventListener('mousemove', move);
          document.addEventListener('mouseup', up);
        });
      }
      function initRowResize() {
        document.addEventListener('mousedown', function (e) {
          var r = e.target && e.target.closest ? e.target.closest('.td-resizer') : null;
          if (!r) return;
          e.preventDefault();
          var tr = r.closest('tr');
          if (!tr) return;
          var startY = e.clientY;
          var startH = tr.getBoundingClientRect().height;
          r.classList.add('dragging');
          function move(ev) {
            var h = Math.max(32, startH + ev.clientY - startY);
            tr.style.height = h + 'px';
            Array.prototype.forEach.call(tr.cells, function (td) { td.style.height = h + 'px'; });
          }
          function up() {
            r.classList.remove('dragging');
            document.removeEventListener('mousemove', move);
            document.removeEventListener('mouseup', up);
          }
          document.addEventListener('mousemove', move);
          document.addEventListener('mouseup', up);
        });
      }

      function openModal(product) {
        modalProduct = product || null;
        document.getElementById('productModal').classList.add('active');
        document.getElementById('modalTitle').textContent = ui(modalProduct ? 'editProductTitle' : 'addProductTitle');
        document.getElementById('slug').disabled = !!modalProduct;
        if (modalProduct) {
          document.getElementById('slug').value = modalProduct.slug || '';
          document.getElementById('position').value = modalProduct.position || 0;
          setActive(modalProduct.active === 0 ? 0 : 1);
          document.getElementById('name_en').value = modalProduct.name_en || '';
          document.getElementById('name_zh').value = modalProduct.name_zh || '';
          document.getElementById('tag_en').value = modalProduct.tag_en || '';
          document.getElementById('category_en').value = modalProduct.category_en || '';
          document.getElementById('category_zh').value = modalProduct.category_zh || '';
          document.getElementById('tag_zh').value = modalProduct.tag_zh || '';
          document.getElementById('description_en').value = modalProduct.description_en || '';
          document.getElementById('description_zh').value = modalProduct.description_zh || '';
          var imgVal = modalProduct.image_url || '';
          if (imgVal === '/images/products/placeholder.svg') imgVal = '';
          document.getElementById('image_url').value = imgVal;
          var sp = splitPrice(modalProduct.price);
          document.getElementById('currency').value = sp.cur;
          document.getElementById('price').value = sp.rest;
          document.getElementById('buy_url').value = modalProduct.buy_url || '';
        } else {
          document.getElementById('productForm').reset();
          document.getElementById('position').value = '0';
        }
      }

      function closeModal() {
        document.getElementById('productModal').classList.remove('active');
        modalProduct = null;
      }

      function editProduct(product) { openModal(product); }

      async function deleteProduct(slug) {
        if (!confirm(ui('deleteConfirm') + ' "' + slug + '"?')) return;
        try {
          var resp = await fetch('/api/products/delete?slug=' + encodeURIComponent(slug), {
            method: 'DELETE',
            headers: { 'Authorization': 'Bearer ' + token }
          });
          if (resp.status === 401) { sessionExpired(); return; }
          var data = await resp.json();
          if (!data.ok) {
            alert(ui('deleteFailed') + (data.message || 'unknown error'));
            return;
          }
          loadProducts();
        } catch (err) {
          alert('Network error');
        }
      }

      document.getElementById('productForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        var data = {
          slug: document.getElementById('slug').value.trim(),
          position: parseInt(document.getElementById('position').value, 10) || 0,
          name_en: document.getElementById('name_en').value,
          name_zh: document.getElementById('name_zh').value,
          tag_en: document.getElementById('tag_en').value,
          tag_zh: document.getElementById('tag_zh').value,
          category_en: document.getElementById('category_en').value,
          category_zh: document.getElementById('category_zh').value,
          description_en: document.getElementById('description_en').value,
          description_zh: document.getElementById('description_zh').value,
          active: activeVal === 0 ? 0 : 1,
          image_url: document.getElementById('image_url').value.trim(),
          price: (document.getElementById('price').value.trim() ? document.getElementById('currency').value + document.getElementById('price').value.trim() : ''),
          buy_url: document.getElementById('buy_url').value.trim()
        };
        try {
          var resp = await fetch('/api/products', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': 'Bearer ' + token
            },
            body: JSON.stringify(data)
          });
          if (resp.status === 401) { sessionExpired(); return; }
          var result = await resp.json();
          if (!result.ok) {
            alert(ui('saveFailed') + (result.message || 'unknown error') +
              (result.message === 'Database not available' ? '（请确认 D1 数据库已绑定）' : ''));
            return;
          }
          closeModal();
          loadProducts();
        } catch (err) {
          alert('Network error');
        }
      });

