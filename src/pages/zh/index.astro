---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/lib/i18n';
import HomeContent from '@/components/HomeContent.astro';

const locale = 'zh';
const title = `${t(locale, 'brand')} — 面向数据驱动型企业的云原生基础设施`;
const description = t(locale, 'hero.subtitle');
---

<BaseLayout title={title} description={description} locale={locale}>
  <HomeContent locale={locale} />
</BaseLayout>
