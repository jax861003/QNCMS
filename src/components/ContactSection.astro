---
import { t, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const info = [
  {
    label: t(locale, 'contact.infoTitle'),
    icon: 'mail',
    items: [
      { lbl: 'Email', attr: { 'data-contact-email': '' }, val: t(locale, 'contact.infoEmail') },
      { lbl: 'Phone', attr: { 'data-contact-phone': '' }, val: t(locale, 'contact.infoPhone') },
      { lbl: 'Office', attr: { 'data-contact-address': '' }, val: t(locale, 'contact.infoAddress') },
      { lbl: t(locale, 'contact.lblQq'), attr: { 'data-contact-qq': '' }, val: t(locale, 'contact.infoQQ') },
      { lbl: t(locale, 'contact.lblWechat'), attr: { 'data-contact-wechat': '' }, val: t(locale, 'contact.infoWechat') },
    ],
  },
];
---

<section class="section" id="contact">
  <div class="container">
    <div class="section-head wide">
      <span class="eyebrow">{t(locale, 'contact.eyebrow')}</span>
      <h2>{t(locale, 'contact.title')}</h2>
      <p>{t(locale, 'contact.subtitle')}</p>
    </div>

    <div class="contact-grid">
      <!-- Direct contact / info -->
      <div class="contact-info" data-reveal>
        {info.map((grp) => (
          <>
                        <ul class="info-list">
              {grp.items.map((it) => (
                <li>
                  <span class="ic" aria-hidden="true">
                    {it.lbl === 'Email' ? (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                    ) : it.lbl === 'Phone' ? (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
                    ) : it.lbl === 'QQ' || it.lbl === 'WeChat' ? (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
                    ) : (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></svg>
                    )}
                  </span>
                  <div>
                    <div class="lbl">{it.lbl}</div>
                    <div class="val" {...it.attr}>{it.val}</div>
                  </div>
                </li>
              ))}
            </ul>
          </>
        ))}
      </div>

      <!-- Form -> /api/contact (Cloudflare Pages Function) -->
      <form
        class="contact-form"
        data-contact-form
        data-sending={t(locale, 'contact.sending')}
        data-success={t(locale, 'contact.success')}
        data-error={t(locale, 'contact.error')}
        data-submit-label={t(locale, 'contact.submit')}
        data-reveal
      >
        <div class="field">
          <label for="cf-name">{t(locale, 'contact.formName')}</label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" placeholder={t(locale, 'contact.formNamePh')} />
        </div>
        <div class="field">
          <label for="cf-email">{t(locale, 'contact.formEmail')}</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder={t(locale, 'contact.formEmailPh')} />
        </div>
        <div class="field">
          <label for="cf-phone">{t(locale, 'contact.formPhone')}</label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" placeholder={t(locale, 'contact.formPhonePh')} />
        </div>
        <div class="field">
          <label for="cf-message">{t(locale, 'contact.formMessage')}</label>
          <textarea id="cf-message" name="message" required placeholder={t(locale, 'contact.formMessagePh')}></textarea>
        </div>
        <button class="btn btn-primary btn-lg" type="submit" data-submit>{t(locale, 'contact.submit')}</button>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
