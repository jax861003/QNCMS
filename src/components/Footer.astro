---
import { t, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href={`/${locale}/`} aria-label={t(locale, 'brand')}>
          <span class="logo-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 16 V8 M9 16 V4 M14 16 V7 M19 16 V10" />
            </svg>
          </span>
          <span data-footer-brand>{t(locale, 'brand')}</span>
        </a>
      </div>

      <div class="footer-col">
        <h4>{t(locale, 'footer.colCompany')}</h4>
        <ul>
          <li><a href={`/${locale}/about/`}>{t(locale, 'nav.about')}</a></li>
          <li><a href={`/${locale}/contact/`}>{t(locale, 'nav.contact')}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span data-footer-copy>© {year} {t(locale, 'brand')}. {t(locale, 'footer.rights')}</span>
      <span class="footer-social">
        <a href="#" data-footer-github style="display:none" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.2 1.9 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>
        </a>
        <a href="#" data-footer-twitter style="display:none" aria-label="Twitter / X">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M18.9 1.2h3.7l-8.1 9.3L24 22.8h-7.5l-5.9-7.7-6.7 7.7H.2l8.7-9.9L0 1.2h7.7l5.3 7 6-7zm-1.3 19.4h2L6.5 3.3h-2.2l13.3 17.3z"/></svg>
        </a>
      </span>
    </div>
  </div>
</footer>
