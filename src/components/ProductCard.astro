---
import type { LocalizedProduct } from '@/lib/products';
import { type Locale } from '@/lib/i18n';

interface Props {
  product: LocalizedProduct;
  locale: Locale;
  /** Page-level strings for "Learn more" etc. */
  learnMore: string;
}
const { product, locale, learnMore } = Astro.props;
const tags = String(product.tag || '').split(/[,，、;；|]/).map((s) => s.trim()).filter(Boolean);
---

<a class="product-card" href={`/${locale}/products/${product.slug}/`} data-slug={product.slug} data-reveal>
  <div class="product-thumb">
    <img src={product.image} alt={product.name} loading="lazy" width="640" height="400" />
    {tags.length > 0 && (
      <div class="product-tags">
        {tags.map((tg) => <span class="product-tag">{tg}</span>)}
      </div>
    )}
  </div>
  <div class="product-body">
    <h3>{product.name}</h3>
  </div>
</a>
