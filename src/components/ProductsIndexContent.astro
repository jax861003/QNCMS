---
import { t, type Locale } from '@/lib/i18n';
import { getProducts } from '@/lib/products';
import ProductCard from '@/components/ProductCard.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const products = getProducts(locale);
const learnMore = t(locale, 'products.learnMore');
---

<section class="section" style="padding-top: clamp(48px,7vw,84px);">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t(locale, 'products.eyebrow')}</span>
      <h2 data-products-title style="font-size: clamp(2rem,4vw,3rem);">{t(locale, 'products.title')}</h2>
      <p data-products-sub style="max-width:52ch;">{t(locale, 'products.subtitle')}</p>
    </div>
    <div class="product-filters">
      <div class="cat-tabs" data-cat-tabs></div>
      <input type="search" class="product-search" data-product-search placeholder={locale === 'zh' ? '搜索产品...' : 'Search products...'} aria-label="Search products" />
    </div>
    <div class="products-grid" data-product-grid>
      {products.map((p) => <ProductCard product={p} locale={locale} learnMore={learnMore} />)}
    </div>
  </div>
</section>
