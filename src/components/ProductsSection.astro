---
import { t, type Locale } from '@/lib/i18n';
import ProductGrid from '@/components/ProductGrid.astro';

interface Props {
  locale: Locale;
  products?: any[];
}
const { locale, products } = Astro.props;
---

<section class="section" id="products">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{t(locale, 'products.eyebrow')}</span>
      <h2 data-products-title>{t(locale, 'products.title')}</h2>
      <p data-products-sub>{t(locale, 'products.subtitle')}</p>
    </div>

    <div class="product-filters">
      <div class="cat-tabs" data-cat-tabs></div>
      <input type="search" class="product-search" data-product-search placeholder={locale === 'zh' ? '搜索产品...' : 'Search products...'} aria-label="Search products" />
    </div>

    <ProductGrid products={products || []} locale={locale} />
  </div>
</section>
