---
import { t, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div>
        <h1 class="hero-title">
          <span data-hero-line1>{t(locale, 'hero.titleLine1')}</span><br />
          <span class="grad" data-hero-line2>{t(locale, 'hero.titleLine2')}</span>
        </h1>
        <p class="hero-sub" data-hero-sub>{t(locale, 'hero.subtitle')}</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href={`/${locale}/products/`}>
            {t(locale, 'hero.primaryCta')}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="btn btn-ghost btn-lg" href={`/${locale}/contact/`}>{t(locale, 'hero.secondaryCta')}</a>
        </div>
      </div>
      <div class="hero-visual" data-reveal>
        <div class="frame">
          <img src="/images/hero-dashboard.png" alt="NovaGrid control dashboard" width="900" height="675" fetchpriority="high" data-hero-img />
        </div>
      </div>
    </div>
  </div>
</section>
