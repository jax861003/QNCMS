---
import { t, localeNames, locales, localeUrl, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const linkFor = (key: string, current: string) => {
  const currentSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
  // match top-level section
  return currentSlug === current ? 'page' : undefined;
};
const section = Astro.url.pathname.split('/').filter(Boolean).pop() || 'index';
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="logo" href={`/${locale}/`} aria-label={t(locale, 'brand')}>
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 16 V8 M9 16 V4 M14 16 V7 M19 16 V10" />
        </svg>
      </span>
      <span data-site-logo>{t(locale, 'brand')}</span>
    </a>

    <nav class="main-nav" data-nav aria-label="Primary">
      <a href={`/${locale}/`} aria-current={section === 'index' ? 'page' : undefined}>{t(locale, 'nav.home')}</a>
      <a href={`/${locale}/products/`} aria-current={section.startsWith('products') ? 'page' : undefined}>{t(locale, 'nav.products')}</a>
      <a href={`/${locale}/about/`} aria-current={section === 'about' ? 'page' : undefined}>{t(locale, 'nav.about')}</a>
      <a href={`/${locale}/contact/`} aria-current={section === 'contact' ? 'page' : undefined}>{t(locale, 'nav.contact')}</a>
      <a class="btn btn-primary" href={`/${locale}/contact/`}>{t(locale, 'nav.cta')}</a>
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" data-theme-toggle type="button" aria-label="Toggle dark mode / 切换深色模式" title="Toggle dark mode / 切换深色模式">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <label class="lang-select-wrap" aria-label="Language / 语言">
        <span class="sr-only">Language / 语言</span>
        <select class="lang-select" aria-label="Language / 语言" onchange="location.href = this.value;">
          {locales.map((l) => (
            <option value={localeUrl(Astro.url.pathname, l)} selected={l === locale}>{localeNames[l]}</option>
          ))}
        </select>
      </label>

      <button class="nav-toggle" data-nav-toggle aria-label="Toggle menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>
</header>
