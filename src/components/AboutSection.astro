---
import { t, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const values = [
  { n: '01', title: t(locale, 'about.value1Title'), body: t(locale, 'about.value1Body') },
  { n: '02', title: t(locale, 'about.value2Title'), body: t(locale, 'about.value2Body') },
  { n: '03', title: t(locale, 'about.value3Title'), body: t(locale, 'about.value3Body') },
];
---

<section class="section soft" id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-body">
        <span class="eyebrow">{t(locale, 'about.eyebrow')}</span>
        <h2 data-about-title style="font-size: clamp(1.9rem,3.4vw,2.6rem); margin:16px 0 20px;">{t(locale, 'about.title')}</h2>
        <p data-about-body>{t(locale, 'about.body')}</p>
      </div>
      <div class="about-values">
        {values.map((v) => (
          <div class="value-card" data-reveal>
            <span class="v-num">{v.n}</span>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
